# Copy to .env and change the passwords before first run.
POSTGRES_USER=gibson
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gibson

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET=boards

# NVMe mount on the Jetson. See SETUP.md.
DATA_ROOT=/mnt/nvme/jetsonapi

# Jetson: nvcr.io/nvidia/l4t-pytorch:r36.2.0-pth2.2-py3  + DOCKER_RUNTIME=nvidia
# Dev box: leave both at the defaults below (CPU torch from PyPI).
GATEWAY_BASE_IMAGE=python:3.12-slim
DOCKER_RUNTIME=runc
DEVICE=
